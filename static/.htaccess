# Serve the prerendered SvelteKit pages from a plain Apache static host.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass through real files (assets, PDFs, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Map extensionless URLs to their prerendered .html file
    # e.g. /impressum -> /impressum.html, /modes/2-jahre-eba -> /modes/2-jahre-eba.html
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Pass through directories that have an index.html (e.g. /admin)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^ - [L]

    # Everything else (unknown paths, bare directories like /modes): serve 404 page
    RewriteRule ^ /404.html [L]
</IfModule>
